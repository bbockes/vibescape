{
  "manifest_version": 3,
  "name": "Vibescape",
  "version": "1.0",
  "description": "Transform your browser into a vibe. Aesthetic themes for your new tab.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "favicon.png",
      "48": "favicon.png",
      "128": "favicon.png"
    }
  },
  "permissions": ["storage", "tabs"],
  "icons": {
    "16": "favicon.png",
    "48": "favicon.png",
    "128": "favicon.png"
  }
}
